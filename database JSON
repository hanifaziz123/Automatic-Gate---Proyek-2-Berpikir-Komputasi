if user:
    print(user["name"], user["balance"])
else:
    print("User tidak ditemukan")

#menambah user baru ke database

def add_user(id, name, status, balance, plat):
    with open("database.json", "r") as f:
        db = json.load(f)
#cek ID sudah ada atau belum
    for u in db["users"]:
        if u["id"] == id:
            print("ID sudah terdaftar!")
            return  

    new_user = {
        "id": id,
        "name": name,
        "status": status,
        "balance": balance,
        "plat": plat,
        "parking": {
            "is_inside": False,
            "last_entry_time": None
        }
    }

    db["users"].append(new_user)

    with open("database.json", "w") as f:
        json.dump(db, f, indent=4)

    print("User berhasil ditambahkan!")

